rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Hamma ko'ra oladi, faqat admin(lar) yoza oladi.
    // ADMIN_EMAIL ni o'zingizning admin pochtangizga almashtiring.
    match /districts/{docId} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.token.email in ["ADMIN_EMAIL"];
    }
  }
}
