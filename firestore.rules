rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Tanlov natijalari: hamma ko'ra oladi, faqat admin o'zgartira oladi.
    match /districts/{docId} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.token.email == "zamonk26@gmail.com";
    }

    // Boshqa barcha ma'lumotlar yopiq.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
